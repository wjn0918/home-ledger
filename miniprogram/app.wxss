/* LinUI-inspired global styles */
page {
  background: #f5f7fa;
  color: #333;
  font-size: 28rpx;
}

.lin-container {
  padding: 24rpx;
}

.lin-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 45, 61, 0.06);
}

.lin-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.lin-subtitle {
  font-size: 24rpx;
  color: #909399;
}

.lin-btn {
  background: #3963bc;
  color: #fff;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.lin-input {
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-top: 14rpx;
}

.lin-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 12rpx 0;
}

.lin-tab {
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: #edf0f5;
  color: #5f6368;
}

.lin-tab.active {
  background: #3963bc;
  color: #fff;
  font-weight: 600;
}

.lin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
