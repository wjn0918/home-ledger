/* Global Modern Styles */
page {
  background: #f8f9fa;
  color: #333;
  font-size: 28rpx;
  --primary-color: #3963bc;
  --secondary-color: #5a8dee;
  --text-main: #303133;
  --text-sub: #909399;
  --bg-card: #ffffff;
  --border-color: #f2f3f5;
}

@font-face {
  font-family: "iconfont"; /* Project id 5181223 */
  /* Color fonts */
  src: 
       url('//at.alicdn.com/t/c/font_5181223_9tqysxxbfnk.woff2?t=1779259749254') format('woff2'),
       url('//at.alicdn.com/t/c/font_5181223_9tqysxxbfnk.woff?t=1779259749254') format('woff'),
       url('//at.alicdn.com/t/c/font_5181223_9tqysxxbfnk.ttf?t=1779259749254') format('truetype');
}

.iconfont {
  font-family: "iconfont" !important;
  font-size: 16px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.icon-lingshi:before {
  content: "\e625";
}

.icon-canyin:before {
  content: "\e644";
}

.icon-yinliao:before {
  content: "\e691";
}

.icon-qita:before {
  content: "\e6d5";
}

.icon-gongjiao:before {
  content: "\e600";
}

.icon-zhufang:before {
  content: "\e63b";
}

.icon-shuiguo:before {
  content: "\e882";
}

.icon-gouwu:before {
  content: "\e899";
}

.icon-shucai:before {
  content: "\e606";
}




.lin-container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Modern Card */
.modern-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.modern-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
  display: block;
}

.modern-subtitle {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* Modern Tabs */
.modern-tabs {
  display: flex;
  background: #f0f2f5;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.modern-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
  transition: all 0.2s;
}

.modern-tab.active {
  background: #fff;
  color: var(--primary-color);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* Modern Button */
.modern-btn {
  background: var(--primary-color);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  transition: opacity 0.2s;
}

.modern-btn:active {
  opacity: 0.8;
}

.modern-btn.secondary {
  background: #f0f4ff;
  color: var(--primary-color);
}

/* Modern Input */
.modern-input-group {
  margin-bottom: 30rpx;
}

.modern-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  display: block;
}

.modern-input {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

/* Bill Item Styles */
.bill-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.bill-item:last-child {
  border-bottom: none;
}

.bill-left {
  display: flex;
  align-items: center;
}

.bill-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #f0f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 40rpx;
}

.bill-info {
  display: flex;
  flex-direction: column;
}

.bill-category {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 4rpx;
}

.bill-note {
  font-size: 24rpx;
  color: var(--text-sub);
}

.bill-right {
  text-align: right;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.bill-amount.expense {
  color: #fa5151;
}

.bill-amount.income {
  color: #07c160;
}

.bill-creator {
  font-size: 20rpx;
  color: #fff;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
}

/* Legacy support for lin- styles if needed, but prefer modern- */
.lin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bill-self { background: #3963bc; }
.bill-member-0 { background: #ff9800; }
.bill-member-1 { background: #4caf50; }
.bill-member-2 { background: #9c27b0; }
.bill-member-3 { background: #f44336; }
