.cook-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 132rpx;
  box-sizing: border-box;
  background: #fff7ed;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #c96f4a;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  color: #5b3a2e;
  font-size: 42rpx;
  font-weight: 600;
}

.recipe-count {
  color: #a78672;
  font-size: 24rpx;
}

.empty-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 36rpx;
  border: 1rpx solid #f0d9c5;
  border-radius: 20rpx;
  background: #fffaf3;
}

.empty-icon {
  margin-bottom: 20rpx;
  font-size: 72rpx;
}

.empty-title {
  color: #5b3a2e;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 12rpx;
  color: #a78672;
  font-size: 24rpx;
}

.recipe-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid #f0d9c5;
  border-radius: 20rpx;
  background: #fffaf3;
  box-shadow: 0 6rpx 20rpx rgba(137, 78, 43, 0.06);
}

.recipe-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recipe-name {
  display: block;
  color: #5b3a2e;
  font-size: 32rpx;
  font-weight: 600;
}

.recipe-date {
  display: block;
  margin-top: 8rpx;
  color: #b69682;
  font-size: 22rpx;
}

.delete-btn {
  padding: 8rpx 14rpx;
  color: #b75d43;
  font-size: 22rpx;
}

.recipe-section {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f4e3d5;
}

.section-label {
  display: block;
  margin-bottom: 8rpx;
  color: #c96f4a;
  font-size: 22rpx;
  font-weight: 600;
}

.recipe-content {
  display: block;
  color: #765344;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
