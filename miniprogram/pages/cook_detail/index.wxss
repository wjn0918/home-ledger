.cook-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 132rpx;
  box-sizing: border-box;
  background: var(--page-background);
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: var(--accent-color);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  color: var(--text-strong);
  font-size: 42rpx;
  font-weight: 600;
}

.recipe-count {
  color: var(--text-muted);
  font-size: 24rpx;
}

.empty-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 36rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 20rpx;
  background: var(--surface-muted);
}

.empty-icon {
  margin-bottom: 20rpx;
  font-size: 72rpx;
}

.empty-title {
  color: var(--text-strong);
  font-size: 30rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 24rpx;
}

.recipe-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 20rpx;
  background: var(--surface-muted);
  box-shadow: 0 6rpx 20rpx rgba(137, 78, 43, 0.06);
}

.recipe-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recipe-name {
  display: block;
  color: var(--text-strong);
  font-size: 32rpx;
  font-weight: 600;
}

.recipe-date {
  display: block;
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.delete-btn {
  padding: 8rpx 14rpx;
  color: var(--accent-dark);
  font-size: 22rpx;
}

.recipe-actions {
  display: flex;
  gap: 18rpx;
}

.edit-btn {
  padding: 8rpx 14rpx;
  color: var(--accent-color);
  font-size: 22rpx;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-bottom: 20rpx;
  border-radius: 14rpx;
}

.recipe-section {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-soft);
}

.section-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--accent-color);
  font-size: 22rpx;
  font-weight: 600;
}

.recipe-content {
  display: block;
  color: var(--text-body);
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.edit-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx;
  background: rgba(42, 24, 17, 0.42);
  box-sizing: border-box;
}

.edit-modal {
  width: 100%;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--surface-muted);
  box-sizing: border-box;
}

.edit-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.edit-modal-title {
  color: var(--text-strong);
  font-size: 34rpx;
  font-weight: 600;
}

.edit-modal-close {
  color: var(--text-muted);
  font-size: 42rpx;
}

.edit-input,
.edit-textarea {
  width: 100%;
  min-height: 80rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 12rpx;
  background: var(--page-background);
  color: var(--text-strong);
  box-sizing: border-box;
}

.edit-textarea {
  min-height: 140rpx;
}

.edit-save-btn {
  padding: 22rpx;
  border-radius: 12rpx;
  background: var(--cook-secondary);
  color: #fff;
  text-align: center;
}
