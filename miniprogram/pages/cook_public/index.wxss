.cook-home {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #fff7ed;
  box-sizing: border-box;
}

.mode-switch {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #c96f4a;
  border-radius: 24rpx;
  color: #a94f32;
  background: #fffaf3;
  font-size: 24rpx;
}

.cook-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5b3a2e;
}

.cook-empty {
  margin-top: 80rpx;
  text-align: center;
  color: #a78672;
}