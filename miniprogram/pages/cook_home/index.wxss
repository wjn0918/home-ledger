.cook-home {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 32rpx calc(160rpx + env(safe-area-inset-bottom, 0px));
  background: var(--page-background);
  box-sizing: border-box;
}

.mode-switch {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--secondary-color);
  border-radius: 24rpx;
  color: var(--primary-color);
  background: var(--surface-muted);
  font-size: 24rpx;
}

.mode-switch-ledger {
  border-color: var(--ledger-secondary);
  color: var(--ledger-primary);
  background: var(--ledger-surface);
}

.cook-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.cook-empty {
  margin-top: 80rpx;
  text-align: center;
  color: var(--text-muted);
}

.menu-layout {
  display: flex;
  height: calc(100vh - 300rpx);
  margin-top: 36rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--surface-muted);
}

.menu-category-panel {
  flex: 1;
  min-height: 0;
  width: 190rpx;
  overflow: hidden;
}

.menu-category-column {
  width: 190rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: rgba(201, 111, 74, 0.08);
}

.add-category-btn {
  flex-shrink: 0;
  padding: 22rpx 10rpx;
  border-top: 1rpx solid var(--surface-border);
  color: var(--cook-primary);
  font-size: 23rpx;
  text-align: center;
}

.menu-category-item {
  padding: 28rpx 18rpx;
  border-left: 6rpx solid transparent;
  color: var(--text-muted);
  font-size: 25rpx;
  text-align: center;
}

.menu-category-item.active {
  border-left-color: var(--cook-secondary);
  background: var(--surface-muted);
  color: var(--cook-primary);
  font-weight: 600;
}

.menu-content-panel {
  flex: 1;
  padding: 18rpx;
  box-sizing: border-box;
}

.menu-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.menu-card {
  width: calc(50% - 8rpx);
  overflow: hidden;
  border: 1rpx solid var(--surface-border);
  border-radius: 16rpx;
  background: var(--page-background);
  box-sizing: border-box;
}

.menu-cover {
  display: block;
  width: 100%;
  height: 180rpx;
}

.menu-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
  font-size: 52rpx;
}

.menu-card-body {
  padding: 16rpx;
}

.menu-card-name,
.menu-card-date {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card-name {
  color: var(--text-strong);
  font-size: 27rpx;
  font-weight: 600;
}

.menu-card-date {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 20rpx;
}

.menu-empty {
  padding-top: 120rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  text-align: center;
}

.fab-btn {
  position: fixed;
  right: 24rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom, 0px));
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, var(--cook-secondary), var(--cook-primary));
  box-shadow: 0 12rpx 32rpx rgba(169, 79, 50, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: transform 0.2s, box-shadow 0.2s;
}

.fab-btn:active {
  transform: scale(0.94);
  box-shadow: 0 8rpx 24rpx rgba(169, 79, 50, 0.26);
}

.fab-icon {
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.menu-detail-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx calc(140rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(42, 24, 17, 0.42);
  box-sizing: border-box;
}

.menu-detail-modal {
  width: 100%;
  max-height: calc(100vh - 220rpx);
  padding: 32rpx;
  overflow-y: auto;
  border-radius: 24rpx;
  background: var(--surface-muted);
  box-sizing: border-box;
}

.menu-detail-cover {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.menu-detail-section {
  margin-bottom: 24rpx;
}

.menu-detail-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--cook-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.menu-detail-text {
  display: block;
  color: var(--text-body);
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.menu-detail-edit-btn {
  margin-top: 12rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: var(--cook-secondary);
  color: #fff;
  font-size: 28rpx;
  text-align: center;
}

.menu-detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.menu-detail-actions .menu-detail-edit-btn,
.menu-detail-record-btn {
  flex: 1;
  margin-top: 0;
}

.menu-detail-record-btn {
  padding: 22rpx;
  border-radius: 14rpx;
  background: var(--primary-soft);
  color: var(--cook-primary);
  font-size: 28rpx;
  text-align: center;
}

.menu-detail-input {
  width: 100%;
  min-height: 150rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 12rpx;
  background: var(--page-background);
  color: var(--text-strong);
  box-sizing: border-box;
}

.detail-cover-editor {
  margin-bottom: 18rpx;
}

.detail-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220rpx;
  border-radius: 14rpx;
  background: var(--page-background);
  color: var(--text-muted);
  font-size: 24rpx;
}

.detail-cover-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.detail-cover-action {
  flex: 1;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--cook-primary);
  font-size: 24rpx;
  text-align: center;
}

.detail-cover-action.danger,
.menu-detail-delete-btn {
  color: var(--danger-color);
}

.menu-detail-delete-btn {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--danger-color);
  border-radius: 14rpx;
  font-size: 27rpx;
  text-align: center;
}

.category-modal {
  max-width: 620rpx;
}

.recipe-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 24rpx calc(140rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(42, 24, 17, 0.42);
  box-sizing: border-box;
}

.recipe-modal {
  width: 100%;
  max-height: calc(100vh - 220rpx);
  padding: 32rpx;
  overflow-y: auto;
  border-radius: 28rpx;
  background: var(--surface-muted);
  box-sizing: border-box;
}

.recipe-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.recipe-modal-title {
  color: var(--text-strong);
  font-size: 36rpx;
  font-weight: 600;
}

.recipe-modal-close {
  padding: 4rpx 12rpx;
  color: var(--text-muted);
  font-size: 44rpx;
  line-height: 1;
}

.recipe-field {
  margin-bottom: 24rpx;
}

.recipe-field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-body);
  font-size: 26rpx;
  font-weight: 600;
}

.recipe-category-picker {
  padding: 20rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 14rpx;
  background: var(--page-background);
  color: var(--text-strong);
  font-size: 27rpx;
}

.cover-picker {
  width: 100%;
  height: 220rpx;
  overflow: hidden;
  border: 1rpx dashed var(--surface-border);
  border-radius: 14rpx;
  background: var(--page-background);
  box-sizing: border-box;
}

.cover-preview,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 24rpx;
}

.cover-placeholder-icon {
  margin-bottom: 8rpx;
  color: var(--cook-secondary);
  font-size: 52rpx;
  line-height: 1;
}

.cover-remove {
  margin-top: 10rpx;
  color: var(--cook-primary);
  font-size: 22rpx;
  text-align: right;
}

.recipe-input,
.recipe-textarea {
  width: 100%;
  min-height: 82rpx;
  padding: 20rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 14rpx;
  background: var(--page-background);
  color: var(--text-strong);
  font-size: 27rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.recipe-textarea {
  min-height: 150rpx;
}

.recipe-steps {
  min-height: 200rpx;
}

.recipe-save-btn {
  margin-top: 8rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: var(--cook-secondary);
  color: var(--surface-muted);
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.recipe-save-btn:active {
  background: var(--cook-primary);
}