.cook-home {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: var(--page-background);
  box-sizing: border-box;
}

.mode-switch {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--secondary-color);
  border-radius: 24rpx;
  color: var(--primary-color);
  background: var(--surface-muted);
  font-size: 24rpx;
}

.mode-switch-ledger {
  border-color: var(--ledger-secondary);
  color: var(--ledger-primary);
  background: var(--ledger-surface);
}

.cook-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.cook-empty {
  margin-top: 80rpx;
  text-align: center;
  color: var(--text-muted);
}