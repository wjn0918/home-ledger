.cook-home {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f8f9fa;
  box-sizing: border-box;
}

.mode-switch {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #3963bc;
  border-radius: 24rpx;
  color: #3963bc;
  font-size: 24rpx;
}

.cook-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #222;
}

.cook-empty {
  margin-top: 80rpx;
  text-align: center;
  color: #999;
}