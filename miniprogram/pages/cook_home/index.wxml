<view class="cook-home theme-cook">
  <view class="mode-switch mode-switch-ledger" bindtap="onSwitchAppMode">去记账</view>
  <view class="cook-title">家庭菜谱</view>
  <view wx:if="{{hasFamily}}" class="menu-layout">
    <view class="menu-category-column">
      <scroll-view class="menu-category-panel" scroll-y="true">
        <view
          wx:for="{{menuCategories}}"
          wx:key="id"
          class="menu-category-item {{selectedCategoryId === item.id ? 'active' : ''}}"
          data-category-id="{{item.id}}"
          bindtap="selectMenuCategory"
        >
          <text class="menu-category-name">{{item.name}}</text>
        </view>
      </scroll-view>
      <view class="add-category-btn" bindtap="onAddCategory">+ 添加分类</view>
    </view>
    <scroll-view class="menu-content-panel" scroll-y="true">
      <view wx:if="{{!menuRows.length}}" class="menu-empty">该分类暂无菜谱</view>
      <view wx:for="{{menuRows}}" wx:for-item="row" wx:key="*this" class="menu-row">
        <view wx:for="{{row}}" wx:for-item="menu" wx:key="id" class="menu-card" data-id="{{menu.id}}" bindtap="openMenuDetail">
          <image wx:if="{{menu.coverImage}}" class="menu-cover" src="{{menu.coverImage}}" mode="aspectFill" />
          <view wx:else class="menu-cover menu-cover-empty">🍲</view>
          <view class="menu-card-body">
            <text class="menu-card-name">{{menu.name}}</text>
            <text class="menu-card-date">{{menu.createdDate}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <view wx:elif="{{!menuCount}}" class="cook-empty">暂无菜谱</view>
  <view class="fab-btn" bindtap="onAddRecipe" aria-label="加菜">
    <text class="fab-icon">+</text>
  </view>

  <view wx:if="{{showMenuDetailModal}}" class="menu-detail-mask" bindtap="closeMenuDetailModal">
    <view class="menu-detail-modal" catchtap="stopMenuDetailPropagation">
      <view class="recipe-modal-header">
        <text class="recipe-modal-title">{{menuDetailEditing ? '编辑菜单' : selectedMenu.name}}</text>
        <text class="recipe-modal-close" bindtap="closeMenuDetailModal">×</text>
      </view>
      <block wx:if="{{!menuDetailEditing}}">
        <image wx:if="{{selectedMenu.coverImage}}" class="menu-detail-cover" src="{{selectedMenu.coverImage}}" mode="aspectFill" />
        <view class="menu-detail-section">
          <text class="menu-detail-label">食材</text>
          <text class="menu-detail-text">{{selectedMenu.ingredients}}</text>
        </view>
        <view class="menu-detail-section">
          <text class="menu-detail-label">做法</text>
          <text class="menu-detail-text">{{selectedMenu.steps}}</text>
        </view>
        <view class="menu-detail-actions">
          <view class="menu-detail-record-btn" bindtap="recordCooked">记录今天做过</view>
          <view class="menu-detail-edit-btn" bindtap="enterMenuEdit">编辑菜单</view>
        </view>
      </block>
      <block wx:else>
        <view class="detail-cover-editor">
          <image wx:if="{{detailCoverImage}}" class="menu-detail-cover" src="{{detailCoverImage}}" mode="aspectFill" />
          <view wx:else class="detail-cover-empty">暂无封面图</view>
          <view class="detail-cover-actions">
            <view class="detail-cover-action" bindtap="chooseDetailCover">更新封面图</view>
            <view wx:if="{{detailCoverImage}}" class="detail-cover-action danger" bindtap="removeDetailCover">移除封面</view>
          </view>
        </view>
        <input class="recipe-input" value="{{detailName}}" bindinput="onDetailNameInput" placeholder="菜名" />
        <textarea class="menu-detail-input" value="{{detailIngredients}}" bindinput="onDetailIngredientsInput" placeholder="食材" auto-height />
        <textarea class="menu-detail-input" value="{{detailSteps}}" bindinput="onDetailStepsInput" placeholder="做法" auto-height />
        <view class="menu-detail-edit-btn" bindtap="saveMenuEdit">保存修改</view>
        <view class="menu-detail-delete-btn" bindtap="deleteMenu">删除菜单</view>
      </block>
    </view>
  </view>

  <view wx:if="{{showAddCategoryModal}}" class="recipe-modal-mask" bindtap="closeAddCategoryModal">
    <view class="recipe-modal category-modal" catchtap="stopCategoryModalPropagation">
      <view class="recipe-modal-header">
        <text class="recipe-modal-title">添加分类</text>
        <text class="recipe-modal-close" bindtap="closeAddCategoryModal">×</text>
      </view>
      <view class="recipe-field">
        <text class="recipe-field-label">分类名称</text>
        <input
          class="recipe-input"
          placeholder="例如：家常菜"
          value="{{newCategoryName}}"
          bindinput="onNewCategoryNameInput"
          maxlength="50"
        />
      </view>
      <view class="recipe-field">
        <text class="recipe-field-label">图标（可选）</text>
        <input
          class="recipe-input"
          placeholder="例如：icon-food"
          value="{{newCategoryIcon}}"
          bindinput="onNewCategoryIconInput"
          maxlength="100"
        />
      </view>
      <view class="recipe-save-btn" bindtap="saveCategory">保存分类</view>
    </view>
  </view>

  <view
    wx:if="{{showAddRecipeModal}}"
    class="recipe-modal-mask"
    bindtap="closeAddRecipeModal"
  >
    <view class="recipe-modal" catchtap="stopModalPropagation">
      <view class="recipe-modal-header">
        <text class="recipe-modal-title">新增菜谱</text>
        <text class="recipe-modal-close" bindtap="closeAddRecipeModal">×</text>
      </view>
      <view class="recipe-field">
        <text class="recipe-field-label">菜名</text>
        <input
          class="recipe-input"
          placeholder="例如：番茄炖牛腩"
          value="{{recipeName}}"
          bindinput="onRecipeNameInput"
          maxlength="40"
        />
      </view>
      <view wx:if="{{recipeCategories.length}}" class="recipe-field">
        <text class="recipe-field-label">分类</text>
        <picker
          mode="selector"
          range="{{recipeCategories}}"
          range-key="name"
          value="{{recipeCategoryIndex}}"
          bindchange="onRecipeCategoryChange"
        >
          <view class="recipe-category-picker">
            {{recipeCategories[recipeCategoryIndex].name || '选择分类'}}
          </view>
        </picker>
      </view>
      <view class="recipe-field">
        <text class="recipe-field-label">封面图</text>
        <view class="cover-picker" bindtap="chooseRecipeCover">
          <image
            wx:if="{{recipeCoverImage}}"
            class="cover-preview"
            src="{{recipeCoverImage}}"
            mode="aspectFill"
          />
          <view wx:else class="cover-placeholder">
            <text class="cover-placeholder-icon">+</text>
            <text>选择封面图</text>
          </view>
        </view>
        <view wx:if="{{recipeCoverImage}}" class="cover-remove" bindtap="removeRecipeCover">移除封面图</view>
      </view>
      <view class="recipe-field">
        <text class="recipe-field-label">食材</text>
        <textarea
          class="recipe-textarea"
          placeholder="写下主要食材和用量"
          value="{{recipeIngredients}}"
          bindinput="onRecipeIngredientsInput"
          maxlength="500"
          auto-height
        />
      </view>
      <view class="recipe-field">
        <text class="recipe-field-label">做法</text>
        <textarea
          class="recipe-textarea recipe-steps"
          placeholder="按顺序写下烹饪步骤"
          value="{{recipeSteps}}"
          bindinput="onRecipeStepsInput"
          maxlength="1000"
          auto-height
        />
      </view>
      <view class="recipe-save-btn" bindtap="saveRecipe">保存菜谱</view>
    </view>
  </view>
</view>