.header {
  background: linear-gradient(135deg, #3963bc 0%, #5a8dee 100%);
  padding: 22rpx 20rpx 24rpx;
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.family-name {
  font-size: 24rpx;
  font-weight: 600;
}

.batch-btn {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.header-stats {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  opacity: 0.9;
}

.header-filters {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.filter-item {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
}

.clear-filter-btn {
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.stat-value {
  font-weight: 600;
  margin-right: 12rpx;
}

.stat-sep {
  margin: 0 12rpx;
  opacity: 0.5;
}

.bill-list {
  padding: 12rpx 16rpx;
  background: #f8f9fa;
}

.container.has-footer {
  padding-bottom: 96rpx;
}

/* 批量操作样式 */
.bill-wrapper {
  display: flex;
  align-items: center;
}

.checkbox-area {
  padding: 0 12rpx 0 16rpx;
}

.checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #dcdfe6;
  border-radius: 50%;
  position: relative;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #3963bc;
  border-color: #3963bc;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  left: 50%;
  top: 45%;
  transform: translate(-50%, -50%) rotate(-45deg);
}

.swipe-area.batch-mode {
  width: 100%;
}

.item-selected {
  background: #f0f7ff !important;
}

.batch-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.footer-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #3963bc;
  padding: 12rpx 0;
  font-weight: 500;
}

.footer-btn.delete {
  color: #ff4d4f;
}

.day-group {
  margin-bottom: 16rpx;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 6rpx;
}

.day-label {
  font-size: 24rpx;
  color: #909399;
  font-weight: 500;
}

.day-total {
  font-size: 22rpx;
  color: #303133;
  font-weight: 600;
}

.modern-card {
  padding: 0;
  overflow: hidden;
}

.swipe-area {
  width: 100%;
  height: 124rpx;
}

.swipe-view {
  width: calc(100vw + 120rpx);
  height: 124rpx;
  display: flex;
}

.bill-item {
  width: calc(100vw - 32rpx);
  padding: 16rpx 18rpx;
  height: 124rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
}

.bill-note {
  font-size: 22rpx;
  color: var(--text-sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320rpx;
}

.swipe-delete {
  width: 120rpx;
  height: 124rpx;
  background: #ff4d4f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  z-index: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  color: #c0c4cc;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}
.bill-icon-font {
  font-size: 40rpx;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.modal-content {
  width: 88%;
  max-height: 72vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.modal-title { font-size: 30rpx; font-weight: 600; }
.close-icon { font-size: 42rpx; color: #999; line-height: 1; }

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  text-align: center;
  background: #f8f9fa;
}

.category-icon-font { font-size: 42rpx; display: block; margin-bottom: 6rpx; }
.modal-category-item { display: flex; flex-direction: column; align-items: center; justify-content: center; }
.modal-category-name { font-size: 22rpx; color: #303133; line-height: 1.3; }
