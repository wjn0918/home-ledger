.cook-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 132rpx;
  box-sizing: border-box;
  background: var(--page-background);
}

.page-heading {
  margin-bottom: 34rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: var(--accent-color);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  color: var(--text-strong);
  font-size: 42rpx;
  font-weight: 600;
}

.page-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.edit-form {
  padding: 28rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 20rpx;
  background: var(--surface-muted);
  box-shadow: 0 6rpx 20rpx rgba(137, 78, 43, 0.06);
}

.field-group {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-body);
  font-size: 26rpx;
  font-weight: 600;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid var(--surface-border);
  border-radius: 14rpx;
  background: var(--page-background);
  color: var(--text-strong);
  font-size: 27rpx;
}

.field-input {
  height: 82rpx;
}

.field-textarea {
  min-height: 150rpx;
  line-height: 1.6;
}

.steps-input {
  min-height: 220rpx;
}

.placeholder {
  color: var(--placeholder-color);
}

.save-btn {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: var(--accent-color);
  color: var(--surface-muted);
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.save-btn:active {
  background: var(--accent-dark);
}
