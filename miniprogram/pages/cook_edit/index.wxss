.cook-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 132rpx;
  box-sizing: border-box;
  background: #fff7ed;
}

.page-heading {
  margin-bottom: 34rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #c96f4a;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  color: #5b3a2e;
  font-size: 42rpx;
  font-weight: 600;
}

.page-copy {
  display: block;
  margin-top: 12rpx;
  color: #a78672;
  font-size: 24rpx;
  line-height: 1.5;
}

.edit-form {
  padding: 28rpx;
  border: 1rpx solid #f0d9c5;
  border-radius: 20rpx;
  background: #fffaf3;
  box-shadow: 0 6rpx 20rpx rgba(137, 78, 43, 0.06);
}

.field-group {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #765344;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid #efd7c3;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #5b3a2e;
  font-size: 27rpx;
}

.field-input {
  height: 82rpx;
}

.field-textarea {
  min-height: 150rpx;
  line-height: 1.6;
}

.steps-input {
  min-height: 220rpx;
}

.placeholder {
  color: #c3a898;
}

.save-btn {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #c96f4a;
  color: #fffaf3;
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.save-btn:active {
  background: #b75d43;
}
