.header {
  background: linear-gradient(135deg, #3963bc 0%, #5a8dee 100%);
  padding: 40rpx 30rpx 80rpx;
  color: #fff;
}

.summary-card {
  margin-top: -60rpx;
  padding: 0 30rpx;
}

.total-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.total-label {
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 16rpx;
}

.total-amount {
  font-size: 64rpx;
  font-weight: 700;
  color: #303133;
}

.filter-section {
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #3963bc;
}

.ranking-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.ranking-item {
  margin-bottom: 30rpx;
}

.ranking-item:last-child {
  margin-bottom: 10rpx;
}

.ranking-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.ranking-name {
  color: #303133;
  font-weight: 500;
}

.ranking-value {
  color: #3963bc;
  font-weight: 600;
}

.progress-bar {
  height: 12rpx;
  background: #f0f2f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #5a8dee, #3963bc);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.trend-section {
  margin-top: 40rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 26rpx;
  color: #606266;
}

.trend-item:last-child {
  border-bottom: none;
}
