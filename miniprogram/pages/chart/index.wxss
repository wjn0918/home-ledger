.header {
  background: linear-gradient(135deg, #3963bc 0%, #5a8dee 100%);
  padding: 26rpx 20rpx 48rpx;
  color: #fff;
}

.summary-card {
  margin-top: -40rpx;
  padding: 0 16rpx;
}

.total-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.total-label {
  font-size: 22rpx;
  color: #909399;
  margin-bottom: 10rpx;
}

.total-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #303133;
}

.filter-section {
  padding: 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 14rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #3963bc;
}

.ranking-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.ranking-item {
  margin-bottom: 16rpx;
}

.ranking-item:last-child {
  margin-bottom: 10rpx;
}

.ranking-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.ranking-name {
  color: #303133;
  font-weight: 500;
}

.ranking-value {
  color: #3963bc;
  font-weight: 600;
}

.progress-bar {
  height: 8rpx;
  background: #f0f2f5;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #5a8dee, #3963bc);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.trend-section {
  margin-top: 12rpx;
}

/* 自定义日期选择器 */
.custom-range-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  background: #fff;
  padding: 12rpx;
  border-radius: 16rpx;
}

.date-btn {
  background: #f5f7fa;
  padding: 8rpx 14rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #3963bc;
}

.date-sep {
  margin: 0 20rpx;
  color: #909399;
}

/* 简易趋势图 */
.line-chart-container {
  padding: 0;
  height: 300rpx;
  position: relative;
  overflow: hidden;
}

ec-canvas {
  width: 100%;
  height: 100%;
}

.empty-chart {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #c0c4cc;
  font-size: 22rpx;
  z-index: 1;
}

/* 成员统计 */
.member-pie-container {
  padding: 0;
  height: 340rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 22rpx;
  color: #606266;
}

.trend-item:last-child {
  border-bottom: none;
}
