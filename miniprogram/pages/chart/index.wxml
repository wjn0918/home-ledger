<view class="container">
  <!-- 顶部渐变背景 -->
  <view class="header">
    <view class="modern-subtitle" style="color: rgba(255,255,255,0.8); margin-bottom: 10rpx;">当前家庭：{{currentFamilyName || '未选择'}}</view>
    <view class="modern-title" style="color: #fff; margin-bottom: 0;">收支统计</view>
  </view>

  <!-- 总支出卡片 -->
  <view class="summary-card">
    <view class="total-box">
      <text class="total-label">总支出 (元)</text>
      <text class="total-amount">¥{{totalExpense}}</text>
    </view>
  </view>

  <view class="filter-section">
    <!-- 范围切换 -->
    <view class="modern-tabs">
      <block wx:for="{{scopeOptions}}" wx:key="*this">
        <view class="modern-tab {{(statScope==='family'&&index===0)||(statScope==='self'&&index===1)?'active':''}}" data-index="{{index}}" bindtap="onScopeTabTap">{{item}}</view>
      </block>
    </view>

    <!-- 维度切换 -->
    <view class="modern-tabs">
      <block wx:for="{{dimensionOptions}}" wx:key="*this">
        <view class="modern-tab {{dimensionIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onDimensionTabTap">{{item}}</view>
      </block>
    </view>

    <!-- 周期切换 -->
    <scroll-view scroll-x class="modern-tabs" style="white-space: nowrap; display: block;">
      <block wx:for="{{periodOptions}}" wx:key="key">
        <view class="modern-tab {{periodIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onPeriodTabTap" style="display: inline-block; width: 100rpx; margin-right: 6rpx;">{{item.label}}</view>
      </block>
      <view class="modern-tab {{periodIndex === -1 ? 'active' : ''}}" bindtap="onCustomPeriodTap" style="display: inline-block; width: 130rpx;">自定义</view>
    </scroll-view>

    <!-- 自定义时间范围选择 -->
    <view wx:if="{{periodIndex === -1}}" class="custom-range-picker">
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="date-btn">{{startDate || '开始日期'}}</view>
      </picker>
      <text class="date-sep">至</text>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
        <view class="date-btn">{{endDate || '结束日期'}}</view>
      </picker>
    </view>

    <!-- 趋势折线图 -->
    <view class="trend-section">
      <view class="section-title">支出趋势图</view>
      <view class="modern-card line-chart-container">
        <ec-canvas id="trend-line-chart" canvas-id="trend-line-chart" ec="{{ ecLine }}"></ec-canvas>
        <view wx:if="{{!linePoints.length}}" class="empty-chart">暂无趋势数据</view>
      </view>
    </view>

    <!-- 家庭成员统计 (仅家庭范围且有数据时显示) -->
    <view class="trend-section" wx:if="{{statScope === 'family' && memberStats.length}}">
      <view class="section-title">成员支出占比</view>
      <view class="modern-card member-pie-container">
        <ec-canvas id="member-pie-chart" canvas-id="member-pie-chart" ec="{{ ecPie }}"></ec-canvas>
      </view>
    </view>

    <!-- 支出排行榜 -->
    <view class="trend-section">
      <view class="section-title">支出分类排行</view>
      <view class="ranking-list" wx:if="{{ranking.length}}">
        <block wx:for="{{ranking}}" wx:key="category">
          <view class="ranking-item">
            <view class="ranking-info">
              <text class="ranking-name">{{item.category}}</text>
              <text class="ranking-value">¥{{item.amount}}</text>
            </view>
            <view class="progress-bar">
              <view class="progress-inner" style="width: {{item.percentage}}%"></view>
            </view>
          </view>
        </block>
      </view>
      <view wx:else class="modern-card" style="text-align: center; color: #999; padding: 36rpx 0;">暂无支出数据</view>
    </view>
  </view>
</view>
