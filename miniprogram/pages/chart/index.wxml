<view class="lin-container">
  <view class="lin-card">
    <view class="lin-row">
            <view class="lin-subtitle">当前家庭：{{currentFamilyName || '未选择'}}</view>
    </view>

    <view class="lin-tabs">
      <block wx:for="{{scopeOptions}}" wx:key="*this">
        <text class="lin-tab {{(statScope==='family'&&index===0)||(statScope==='self'&&index===1)?'active':''}}" data-index="{{index}}" bindtap="onScopeTabTap">{{item}}</text>
      </block>
    </view>

    <view class="lin-tabs">
      <block wx:for="{{dimensionOptions}}" wx:key="*this">
        <text class="lin-tab {{dimensionIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onDimensionTabTap">{{item}}</text>
      </block>
    </view>

    <view class="lin-tabs">
      <block wx:for="{{periodOptions}}" wx:key="key">
        <text class="lin-tab {{periodIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onPeriodTabTap">{{item.label}}</text>
      </block>
    </view>

    <view class="lin-subtitle">总支出：¥{{totalExpense}}</view>
  </view>

  <view class="lin-card">
    <view class="lin-subtitle">支出折线图（文本版）</view>
    <block wx:for="{{trendPoints}}" wx:key="*this">
      <view>{{item}}</view>
    </block>
  </view>

  <view class="lin-card">
    <view class="lin-subtitle">支出排行榜</view>
    <block wx:for="{{ranking}}" wx:key="category">
      <view class="lin-row" style="margin-top:10rpx;">
        <view>{{index + 1}}. {{item.category}}</view>
        <view>¥{{item.amount}}</view>
      </view>
    </block>
  </view>
</view>
