<view class="container">
  <!-- 初始状态：点击开始记账 -->
  <view class="start-view" wx:if="{{!showCategoryModal && !showDetailModal}}">
    <view class="header">
      <view class="modern-subtitle" style="color: rgba(255,255,255,0.8); margin-bottom: 10rpx;">每一笔支出都值得被记录</view>
      <view class="modern-title" style="color: #fff; margin-bottom: 0;">{{currentFamilyName || '未选择家庭'}}</view>
    </view>
    <view class="start-btn-container">
      <view class="start-circle-btn" bindtap="openCategoryModal">
        <text class="plus-icon">+</text>
        <text class="btn-text">开始记账</text>
      </view>
    </view>
  </view>

  <!-- 弹窗：添加分类（独立弹窗） -->
  <view class="modal-overlay" wx:if="{{showAddCategoryPanel}}" bindtap="closeAddCategoryPanel">
    <view class="modal-content category-modal" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">添加类别</text>
        <text class="close-icon" bindtap="closeAddCategoryPanel">×</text>
      </view>
      <view class="add-category-panel">
        <view class="current-icon-wrap">
          <text class="current-icon-label">当前图标</text>
          <text class="iconfont current-icon-font {{newCategoryIcon || 'icon-qita'}}"></text>
        </view>
        <input
          class="new-category-input"
          placeholder="请输入类别名称，例如：零食"
          value="{{newCategoryName}}"
          bindinput="onNewCategoryNameInput"
        />
        <view class="icon-grid-title">选择图标</view>
        <view class="icon-grid">
          <block wx:for="{{defaultIcons}}" wx:key="*this">
            <view
              class="icon-item {{newCategoryIcon === item ? 'active' : ''}}"
              data-icon="{{item}}"
              bindtap="onNewCategoryIconSelect"
            >
              <text class="iconfont icon-item-font {{item}}"></text>
            </view>
          </block>
        </view>
        <view class="add-category-actions">
          <view class="action-btn cancel" bindtap="closeAddCategoryPanel">取消</view>
          <view class="action-btn confirm" bindtap="onConfirmAddCategory">添加类别</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 弹窗1：选择分类 -->
  <view class="modal-overlay" wx:if="{{showCategoryModal}}" bindtap="closeModals">
    <view class="modal-content category-modal" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">选择分类</text>
        <text class="close-icon" bindtap="closeModals">×</text>
      </view>
      <view class="category-grid">
        <block wx:for="{{categoryOptions}}" wx:key="id">
          <view class="category-item {{category === item.name ? 'active' : ''}}" data-category="{{item.name}}" data-icon="{{item.icon}}" bindtap="onCategorySelect" bindlongpress="onCategoryLongPress">
            <text class="iconfont category-icon-font {{item.icon || 'icon-qita'}}"></text>
            <text class="category-name">{{item.name}}</text>
          </view>
        </block>
        <view class="category-item add-category" bindtap="onAddCategoryTap">
          <text class="category-icon">⚙</text>
          <text class="category-name">设置</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 弹窗：分类设置（排序、删除、添加） -->
  <view class="modal-overlay" wx:if="{{showCategorySettingsModal}}" bindtap="closeModals">
    <view class="modal-content category-modal" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">分类设置</text>
        <text class="close-icon" bindtap="closeModals">×</text>
      </view>
      <view class="settings-list">
        <block wx:for="{{categoryOptions}}" wx:key="id">
          <view
            class="settings-item-wrapper"
            data-id="{{item.id}}"
            data-index="{{index}}"
            bindtouchstart="onCategoryTouchStart"
            catchtouchstart="onCategoryTouchStart"
            bindtouchmove="onCategoryTouchMove"
            catchtouchmove="onCategoryTouchMove"
            bindtouchend="onCategoryTouchEnd"
            catchtouchend="onCategoryTouchEnd"
            bindtouchcancel="onCategoryTouchEnd"
            catchtouchcancel="onCategoryTouchEnd"
          >
            <view class="settings-item {{draggingCategoryId === item.id ? 'dragging' : ''}}" style="transform: translateY({{item.y || 0}}px);">
              <view class="settings-meta">
                <text class="iconfont category-icon-font {{item.icon || 'icon-qita'}}"></text>
                <text class="settings-name">{{item.name}}</text>
              </view>
              <view class="settings-actions">
                <view class="drag-hint">按住拖动</view>
                <view class="delete-btn" bindtap="onDeleteCategoryTap" data-id="{{item.id}}" data-name="{{item.name}}">删除</view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="add-category-footer">
        <view class="action-btn confirm" bindtap="openAddCategoryPanel">添加类别</view>
      </view>
    </view>
  </view>

  <!-- 弹窗：转移账单目标选择 -->
  <view class="modal-overlay" wx:if="{{showTransferModal}}" bindtap="closeModals">
    <view class="modal-content category-modal" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">转移账单</text>
        <text class="close-icon" bindtap="closeModals">×</text>
      </view>
      <view class="transfer-note">
        <text>“{{pendingDeleteCategoryName}}” 下有 {{pendingDeleteCount}} 笔账单，请选择转移目标类别。</text>
      </view>
      <view class="transfer-grid">
        <block wx:for="{{transferOptions}}" wx:key="id">
          <view
            class="transfer-item {{transferTargetCategoryId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onTransferTargetSelect"
          >
            <text class="iconfont category-icon-font {{item.icon || 'icon-qita'}}"></text>
            <text class="transfer-name">{{item.name}}</text>
          </view>
        </block>
      </view>
      <view class="add-category-actions">
        <view class="action-btn cancel" bindtap="closeModals">取消</view>
        <view class="action-btn confirm" bindtap="onConfirmTransfer">转移并删除</view>
      </view>
    </view>
  </view>

  <!-- 弹窗2：输入金额、备注、时间 -->
  <view class="modal-overlay" wx:if="{{showDetailModal}}" bindtap="closeModals">
    <view class="modal-content detail-modal" catchtap="stopBubble">
      <view class="modal-header">
        <view class="selected-category">
          <text class="iconfont cat-icon-font {{categoryIcon || 'icon-qita'}}"></text>
          <text>{{category}}</text>
        </view>
        <text class="close-icon" bindtap="closeModals">×</text>
      </view>

      <!-- 金额显示与计算过程 -->
      <view class="amount-display-area">
        <view class="calc-expr">{{calcExpr || ' '}}</view>
        <view class="amount-val">
          <text class="symbol">¥</text>
          <text class="value">{{amount || '0.00'}}</text>
        </view>
      </view>

      <!-- 备注与日期 -->
      <view class="input-rows">
        <view class="input-row">
          <text class="row-label">备注</text>
          <input class="row-input" placeholder="点击输入备注..." value="{{note}}" bindinput="bindNote" />
        </view>
        <picker mode="date" value="{{billDate}}" bindchange="onDateChange">
          <view class="input-row">
            <text class="row-label">日期</text>
            <view class="row-value">{{billDate}}</view>
          </view>
        </picker>
      </view>

      <!-- 数字键盘/计算器 -->
      <view class="calculator">
        <view class="calc-grid">
          <view class="calc-btn" bindtap="onCalcInput" data-val="7">7</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="8">8</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="9">9</view>
          <view class="calc-btn op" bindtap="onCalcInput" data-val="back">退格</view>
          
          <view class="calc-btn" bindtap="onCalcInput" data-val="4">4</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="5">5</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="6">6</view>
          <view class="calc-btn op" bindtap="onCalcInput" data-val="+">+</view>
          
          <view class="calc-btn" bindtap="onCalcInput" data-val="1">1</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="2">2</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="3">3</view>
          <view class="calc-btn op" bindtap="onCalcInput" data-val="-">-</view>
          
          <view class="calc-btn" bindtap="onCalcInput" data-val=".">.</view>
          <view class="calc-btn" bindtap="onCalcInput" data-val="0">0</view>
          <view class="calc-btn op" bindtap="onCalcInput" data-val="=">=</view>
          <view class="calc-btn submit" bindtap="onSubmit">完成</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 弹窗4：编辑分类图标 -->
  <view class="modal-overlay" wx:if="{{showEditCategoryIconModal}}" bindtap="closeModals">
    <view class="modal-content category-modal" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">选择分类图标</text>
        <text class="close-icon" bindtap="closeModals">×</text>
      </view>
      <view class="add-category-panel">
        <view class="icon-grid-title">长按「{{editingCategoryName}}」后选择图标</view>
        <view class="icon-grid">
          <block wx:for="{{defaultIcons}}" wx:key="*this">
            <view
              class="icon-item {{editingCategoryIcon === item ? 'active' : ''}}"
              data-icon="{{item}}"
              bindtap="onEditCategoryIconSelect"
            >
              <text class="iconfont icon-item-font {{item}}"></text>
            </view>
          </block>
        </view>
        <view class="add-category-actions">
          <view class="action-btn cancel" bindtap="closeModals">取消</view>
          <view class="action-btn confirm" bindtap="onConfirmEditCategoryIcon">确定</view>
        </view>
      </view>
    </view>
  </view>
</view>
