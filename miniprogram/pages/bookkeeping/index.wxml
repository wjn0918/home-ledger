<view class="lin-container">
  <view class="lin-card">
    <view class="lin-title">记一笔</view>
    <view class="lin-subtitle">当前家庭：{{currentFamilyName || '未选择'}}</view>

    <picker mode="selector" range="{{families}}" range-key="name" value="{{familyIndex}}" bindchange="onFamilyChange">
      <view class="lin-tab">切换家庭</view>
    </picker>

    <input class="lin-input" placeholder="金额" type="digit" bindinput="bindAmount" />
    <picker mode="selector" range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="lin-input">账单类别：{{category}}</view>
    </picker>
    <picker mode="date" value="{{billDate}}" bindchange="onDateChange">
      <view class="lin-input">记账日期：{{billDate}}</view>
    </picker>
    <input class="lin-input" placeholder="新增类别（如：零食）" value="{{newCategory}}" bindinput="bindNewCategory" />
    <button class="lin-btn" bindtap="addCustomCategory">添加账单类别</button>
    <input class="lin-input" placeholder="备注" bindinput="bindNote" />
    <button class="lin-btn" bindtap="onSubmit">提交记账</button>
  </view>
</view>
