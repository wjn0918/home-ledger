.header {
  background: linear-gradient(135deg, #3963bc 0%, #5a8dee 100%);
  padding: 40rpx 30rpx 100rpx;
  color: #fff;
}

/* 开始记账视图 */
.start-view {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.start-btn-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0 200rpx;
}

.pending-bubble-section {
  margin: -40rpx 30rpx 0;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(57, 99, 188, 0.12);
}

.pending-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pending-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.pending-subtitle {
  font-size: 24rpx;
  color: #909399;
}

.pending-bubble-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pending-bubble {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #3963bc;
}

.pending-bubble-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.pending-bubble-text {
  font-size: 24rpx;
  white-space: nowrap;
}

.pending-strip {
  position: relative;
  z-index: 2;
  margin: 24rpx 30rpx 0;
  padding: 0 0 18rpx;
}

.pending-strip-list {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 18rpx;
  padding: 0 4rpx 8rpx;
}

.pending-chip {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1 1 280rpx;
  min-width: 280rpx;
  max-width: calc(50% - 10rpx);
  padding: 18rpx 22rpx 16rpx 18rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(237,244,255,0.96) 100%);
  border: 1px solid rgba(57, 99, 188, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(57, 99, 188, 0.12);
  color: #3963bc;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.pending-chip-active {
  transform: translateY(-2rpx) scale(0.98);
  background: linear-gradient(135deg, rgba(238,246,255,1) 0%, rgba(220,234,255,1) 100%);
  box-shadow: 0 14rpx 26rpx rgba(57, 99, 188, 0.18);
}

.pending-chip-glow {
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #73a8ff 0%, #3963bc 100%);
  box-shadow: 0 0 0 8rpx rgba(57, 99, 188, 0.12);
  animation: pendingPulse 1.8s ease-in-out infinite;
}

@keyframes pendingPulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.25); opacity: 1; }
}

.pending-chip-header,
.pending-chip-meta {
  position: relative;
  z-index: 1;
}

.pending-chip-header {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 42rpx;
}

.pending-chip-icon {
  font-size: 30rpx;
  margin-left: 18rpx;
}

.pending-chip-amount {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.pending-chip-action {
  margin-left: auto;
  font-size: 42rpx;
  line-height: 1;
  opacity: 0.75;
}

.pending-chip-meta {
  margin-top: 8rpx;
  margin-left: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5e6d99;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pending-chip-date {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  margin-left: 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #7c8caf;
}

.start-circle-btn {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #3963bc, #5a8dee);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 20rpx 40rpx rgba(57, 99, 188, 0.2);
  transition: all 0.2s;
}

.start-circle-btn:active {
  transform: scale(0.95);
  box-shadow: 0 10rpx 20rpx rgba(57, 99, 188, 0.2);
}

.plus-icon {
  font-size: 80rpx;
  font-weight: 300;
  line-height: 1;
  margin-bottom: 10rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 弹窗基础样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  padding: 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f2f3f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.close-icon {
  font-size: 48rpx;
  color: #909399;
  padding: 10rpx;
}

/* 分类弹窗 */
.category-modal {
  max-height: 80vh;
  overflow-y: auto;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 40rpx;
}

.settings-list {
  padding: 0 40rpx 20rpx;
}

.settings-item-wrapper {
  overflow: hidden;
  border-bottom: 1rpx solid #f2f3f5;
  position: relative;
}

.settings-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  background: #fff;
}

.settings-meta {
  display: flex;
  align-items: center;
}

.settings-name {
  font-size: 30rpx;
  color: #303133;
  margin-left: 18rpx;
}

.settings-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edit-btn,
.delete-btn {
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  font-size: 24rpx;
  color: #606266;
}

.edit-btn {
  background: #ecf5ff;
  color: #3963bc;
}

.delete-btn {
  background: #ffecec;
  color: #f56c6c;
}

.add-category-footer {
  padding: 20rpx 40rpx 40rpx;
}

.add-category-footer .action-btn {
  width: 100%;
}

.transfer-note {
  padding: 28rpx 40rpx 0;
  font-size: 28rpx;
  color: #606266;
}

.transfer-grid {
  padding: 20rpx 40rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.transfer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8f9fa;
  transition: all 0.2s;
}

.transfer-item.active {
  background: #edf4ff;
  border: 1rpx solid #3963bc;
}

.transfer-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #303133;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: #f8f9fa;
  border-radius: 20rpx;
}

.category-item.active {
  background: #f0f4ff;
  color: #3963bc;
}

/* 详情弹窗 */
.selected-category {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #3963bc;
}

.cat-icon {
  margin-right: 12rpx;
}

.category-icon-font {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.cat-icon-font {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.amount-display-area {
  padding: 40rpx;
  background: #f8f9fa;
  text-align: right;
}

.calc-expr {
  font-size: 28rpx;
  color: #909399;
  height: 40rpx;
  margin-bottom: 10rpx;
}

.amount-val {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
}

.amount-val .symbol {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.amount-val .value {
  font-size: 64rpx;
  font-weight: 700;
}

.input-rows {
  padding: 0 40rpx;
}

.input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.row-label {
  font-size: 28rpx;
  color: #606266;
}

.row-input {
  text-align: right;
  flex: 1;
  margin-left: 40rpx;
  font-size: 28rpx;
}

.row-value {
  font-size: 28rpx;
  color: #303133;
}

/* 计算器 */
.calculator {
  background: #f2f3f5;
  padding: 20rpx;
}

.calc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.calc-btn {
  height: 100rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.calc-btn:active {
  background: #f0f2f5;
}

.calc-btn.op {
  background: #eef1f5;
  color: #3963bc;
}

.calc-btn.submit {
  background: #3963bc;
  color: #fff;
  grid-row: span 1;
}

.calc-btn.submit:active {
  opacity: 0.9;
}

.add-category-panel {
  padding: 28rpx 32rpx 36rpx;
}

.current-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.current-icon-label {
  font-size: 26rpx;
  color: #606266;
}

.current-icon-val {
  font-size: 30rpx;
  color: #3963bc;
  font-weight: 600;
}

.current-icon-font {
  font-size: 42rpx;
}

.new-category-input {
  height: 76rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 22rpx;
}

.icon-grid-title {
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 14rpx;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.icon-item {
  height: 72rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.icon-item-font {
  font-size: 36rpx;
}

.icon-item.active {
  background: #eaf1ff;
  color: #3963bc;
  border: 1rpx solid #3963bc;
}

.add-category-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

.pending-action-panel {
  padding: 28rpx 32rpx 36rpx;
}

.pending-action-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f8f9fa;
}

.pending-action-icon {
  font-size: 56rpx;
  color: #3963bc;
}

.pending-action-meta {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.pending-action-category {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.pending-action-amount {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #3963bc;
}

.pending-action-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #606266;
}

.pending-action-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #909399;
}

.pending-action-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #606266;
}

.action-btn {
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.action-btn.cancel {
  background: #f2f3f5;
  color: #606266;
}

.action-btn.confirm {
  background: #3963bc;
  color: #fff;
}
