.header {
  background: linear-gradient(135deg, #3963bc 0%, #5a8dee 100%);
  padding: 40rpx 30rpx 100rpx;
  color: #fff;
}

/* 开始记账视图 */
.start-view {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.start-btn-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 200rpx;
}

.start-circle-btn {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #3963bc, #5a8dee);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 20rpx 40rpx rgba(57, 99, 188, 0.2);
  transition: all 0.2s;
}

.start-circle-btn:active {
  transform: scale(0.95);
  box-shadow: 0 10rpx 20rpx rgba(57, 99, 188, 0.2);
}

.plus-icon {
  font-size: 80rpx;
  font-weight: 300;
  line-height: 1;
  margin-bottom: 10rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 弹窗基础样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  padding: 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f2f3f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.close-icon {
  font-size: 48rpx;
  color: #909399;
  padding: 10rpx;
}

/* 分类弹窗 */
.category-modal {
  max-height: 80vh;
  overflow-y: auto;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 40rpx;
}

.settings-list {
  padding: 0 40rpx 20rpx;
}

.settings-item-wrapper {
  overflow: hidden;
  border-bottom: 1rpx solid #f2f3f5;
  position: relative;
}

.settings-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  background: #fff;
  transition: transform 0.1s ease;
}

.settings-item.dragging {
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 2;
}

.drag-hint {
  font-size: 24rpx;
  color: #909399;
  margin-right: 14rpx;
}

.settings-meta {
  display: flex;
  align-items: center;
}

.settings-name {
  font-size: 30rpx;
  color: #303133;
  margin-left: 18rpx;
}

.settings-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sort-btn,
.delete-btn {
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  font-size: 24rpx;
  color: #606266;
}

.delete-btn {
  background: #ffecec;
  color: #f56c6c;
}

.transfer-note {
  padding: 28rpx 40rpx 0;
  font-size: 28rpx;
  color: #606266;
}

.transfer-grid {
  padding: 20rpx 40rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.transfer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8f9fa;
  transition: all 0.2s;
}

.transfer-item.active {
  background: #edf4ff;
  border: 1rpx solid #3963bc;
}

.transfer-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #303133;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: #f8f9fa;
  border-radius: 20rpx;
}

.category-item.active {
  background: #f0f4ff;
  color: #3963bc;
}

/* 详情弹窗 */
.selected-category {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #3963bc;
}

.cat-icon {
  margin-right: 12rpx;
}

.category-icon-font {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.cat-icon-font {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.amount-display-area {
  padding: 40rpx;
  background: #f8f9fa;
  text-align: right;
}

.calc-expr {
  font-size: 28rpx;
  color: #909399;
  height: 40rpx;
  margin-bottom: 10rpx;
}

.amount-val {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
}

.amount-val .symbol {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.amount-val .value {
  font-size: 64rpx;
  font-weight: 700;
}

.input-rows {
  padding: 0 40rpx;
}

.input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.row-label {
  font-size: 28rpx;
  color: #606266;
}

.row-input {
  text-align: right;
  flex: 1;
  margin-left: 40rpx;
  font-size: 28rpx;
}

.row-value {
  font-size: 28rpx;
  color: #303133;
}

/* 计算器 */
.calculator {
  background: #f2f3f5;
  padding: 20rpx;
}

.calc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.calc-btn {
  height: 100rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.calc-btn:active {
  background: #f0f2f5;
}

.calc-btn.op {
  background: #eef1f5;
  color: #3963bc;
}

.calc-btn.submit {
  background: #3963bc;
  color: #fff;
  grid-row: span 1;
}

.calc-btn.submit:active {
  opacity: 0.9;
}

.add-category-panel {
  padding: 28rpx 32rpx 36rpx;
}

.current-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.current-icon-label {
  font-size: 26rpx;
  color: #606266;
}

.current-icon-val {
  font-size: 30rpx;
  color: #3963bc;
  font-weight: 600;
}

.current-icon-font {
  font-size: 42rpx;
}

.new-category-input {
  height: 76rpx;
  border: 1rpx solid #dcdfe6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin-bottom: 22rpx;
}

.icon-grid-title {
  font-size: 26rpx;
  color: #606266;
  margin-bottom: 14rpx;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.icon-item {
  height: 72rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.icon-item-font {
  font-size: 36rpx;
}

.icon-item.active {
  background: #eaf1ff;
  color: #3963bc;
  border: 1rpx solid #3963bc;
}

.add-category-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-btn {
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.action-btn.cancel {
  background: #f2f3f5;
  color: #606266;
}

.action-btn.confirm {
  background: #3963bc;
  color: #fff;
}
