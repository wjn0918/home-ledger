.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 26rpx;
}

.tab-item.active {
  color: #3963bc;
}

.cook-tab-bar {
  background: #fffaf3;
  border-top-color: #f0d9c5;
}

.cook-tab-bar .tab-item.active {
  color: #a94f32;
}